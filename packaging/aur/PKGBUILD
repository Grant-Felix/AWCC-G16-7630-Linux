# Maintainer: Felix
# 注：AUR 准则要求这一行写「名字 <邮箱>」，但本仓库约定不放真实邮箱（见 ADAPTATION.md），
# 推送前请按 packaging/aur/README.md 把邮箱补上。# 从 GitHub 上的 release tag 构建（Gitee 是同一份代码的国内镜像）。
#
# 注意版本号映射：Arch 的 pkgver 不允许含连字符，所以上游的 "26.9.22-2" 在这里写成
# "26.9.22_2"。发布新版时两处都要改：pkgver 与下面 source 里的标签。
pkgname=awcc-g16-7630-linux
pkgver=26.9.23_1
pkgrel=1
pkgdesc="Alienware Command Center for the Dell G16 7630 (GTK4 frontend, fork of tr1xem/AWCC)"
arch=('x86_64')
url="https://github.com/Grant-Felix/AWCC-G16-7630-Linux"
license=('GPL-3.0-only')
# libusb 与 libevdev 是静态链接进来的，不需要列为依赖；
# systemd-libs 提供 libudev（动态链接），acpi_call-dkms 是热模式/风扇控制的运行前提
depends=('gtk4' 'libadwaita' 'glib2' 'gcc-libs' 'systemd-libs' 'acpi_call-dkms')
# libusb 构建时要用 libudev.h，它随 systemd-libs 来；那个包已在 depends 里，
# 就不再重复列进 makedepends（namcap 会报 "already included as dependency"）
makedepends=('cmake' 'ninja' 'meson' 'git' 'pkgconf')
# 与上游作者 tr1xem 的 awcc-bin / awcc-git 同装 /usr/bin/awcc，必须冲突；
# 三个包都 provides=awcc，所以列出 awcc 也覆盖它们，这里显式写全便于读者理解
provides=('awcc')
conflicts=('awcc' 'awcc-bin' 'awcc-git')
# 上游 tag 是 v26.9.22-2，pkgver 里用下划线，这里再换回连字符
source=("$pkgname-$pkgver.tar.gz::https://github.com/Grant-Felix/AWCC-G16-7630-Linux/archive/refs/tags/v${pkgver/_/-}.tar.gz")
sha256sums=('95b4c0e703a8c6c82406e5c445aaa4862b3ffdda6c9458bb8e1394a0265cf6ce')

build() {
  local srcdir_name="AWCC-G16-7630-Linux-${pkgver/_/-}"
  cmake -S "$srcdir/$srcdir_name" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DAWCC_VERSION="${pkgver/_/-}"
  ninja -C build
}

package() {
  local srcdir_name="AWCC-G16-7630-Linux-${pkgver/_/-}"
  DESTDIR="$pkgdir" cmake --install build --component awcc
  install -Dm644 "$srcdir/$srcdir_name/LICENSE" \
          "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
