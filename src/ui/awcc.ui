<?xml version="1.0" encoding="UTF-8"?>
<!--
  主窗口外壳：左导航栏 + 面包屑 + 内容 GtkStack。
  - 页面本体由 src/ui/Ui.cpp 生成——M0 阶段还是「施工中」占位，各里程碑接入后端后再逐个搬成 .ui。
  - 串一律写英文并标 translatable="yes"：GtkBuilder 按 Ui.cpp 设的 gettext 域查 po/zh_CN.po，
    查不到就回落成这里的英文，于是中文环境中文、其他环境英文。
  - content_root 是内容根节点：Ui.cpp 在它上面挂帧时钟回调，用内容区尺寸算图标边长。
    （不用自定义容器 + size_allocate vfunc：GtkBox 自带 layout manager，GTK4 在这种情况下
    不会调用该 vfunc，实测加探针一次都没进。）
-->
<interface>
  <requires lib="gtk" version="4.10" />
  <requires lib="Adw" version="1.0" />

  <object class="AdwApplicationWindow" id="main_window">
    <property name="default-width">1280</property>
    <property name="default-height">800</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <property name="title-widget">
              <object class="GtkBox" id="crumb_box">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="crumb_main">
                    <property name="name">crumb_main</property>
                    <property name="label" translatable="yes">Home</property>
                    <attributes>
                      <attribute name="weight" value="bold" />
                    </attributes>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">|</property>
                    <property name="name">crumb_sep</property>
                    <property name="opacity">0.4</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="crumb_sub">
                    <property name="name">crumb_sub</property>
                    <property name="label" translatable="yes">System</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox" id="content_root">
            <property name="orientation">horizontal</property>
            <child>
              <object class="GtkBox" id="nav_rail">
                <property name="name">nav_rail</property>
                <property name="orientation">vertical</property>
                <property name="spacing">2</property>
                <property name="width-request">56</property>
                <property name="margin-top">8</property>
                <property name="margin-bottom">8</property>
                <child>
                  <object class="GtkToggleButton" id="nav_home">
                    <property name="name">home</property>
                    <property name="icon-name">go-home-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Home</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="nav_performance">
                    <property name="name">performance</property>
                    <property name="icon-name">power-profile-performance-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Performance</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="nav_alienfx">
                    <property name="name">alienfx</property>
                    <property name="icon-name">input-keyboard-symbolic</property>
                    <property name="tooltip-text" translatable="yes">ALIENFX™</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="nav_macro">
                    <property name="name">macro</property>
                    <property name="icon-name">media-playlist-consecutive-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Macros</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="nav_library">
                    <property name="name">library</property>
                    <property name="icon-name">view-grid-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Library</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="vexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="nav_settings">
                    <property name="name">settings</property>
                    <property name="icon-name">preferences-system-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Settings</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="nav_help">
                    <property name="name">help</property>
                    <property name="icon-name">help-about-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Help</property>
                    <property name="has-frame">false</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkStack" id="content_stack">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="transition-type">crossfade</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>
